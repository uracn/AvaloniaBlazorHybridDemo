<?xml version="1.0" encoding="utf-8" ?>
<!-- NativeAOT 实验：Blazor Hybrid 的组件实例化、JS interop、IPC 序列化以及
     第三方 WebView 包基于 DryIoc 的反射注册都依赖运行时反射，全量裁剪会
     移除这些入口。参照 MauiBlazorAotDemo/Roots.xml，并补充 Avalonia WebView
     相关程序集。注意：这只能解决「类型被裁掉」，无法解决反射式
     System.Text.Json 在 NativeAOT 下被禁用的问题。 -->
<linker>
    <assembly fullname="AvaloniaBlazorHybridDemo" preserve="all" />

    <!-- Blazor / JS interop -->
    <assembly fullname="Microsoft.AspNetCore.Components" preserve="all" />
    <assembly fullname="Microsoft.AspNetCore.Components.Forms" preserve="all" />
    <assembly fullname="Microsoft.AspNetCore.Components.Web" preserve="all" />
    <assembly fullname="Microsoft.AspNetCore.Components.WebView" preserve="all" />
    <assembly fullname="Microsoft.JSInterop" preserve="all" />

    <!-- Avalonia BlazorWebView + 平台 WebView 后端 -->
    <assembly fullname="BlazorWebView.Avalonia" preserve="all" />
    <assembly fullname="Avalonia.BlazorWebView" preserve="all" />
    <assembly fullname="AvaloniaWebView.Shared" preserve="all" />
    <assembly fullname="WebView.Core" preserve="all" />
    <assembly fullname="Avalonia.WebView.Desktop" preserve="all" />
    <assembly fullname="Avalonia.WebView.Windows" preserve="all" />
    <assembly fullname="Microsoft.Web.WebView2.Core" preserve="all" />
    <assembly fullname="DryIoc.Shared" preserve="all" />

    <!-- Avalonia XAML / 控件反射加载 -->
    <assembly fullname="Avalonia.Base" preserve="all" />
    <assembly fullname="Avalonia.Controls" preserve="all" />
    <assembly fullname="Avalonia.Markup" preserve="all" />
    <assembly fullname="Avalonia.Markup.Xaml" preserve="all" />
    <assembly fullname="Avalonia.Themes.Fluent" preserve="all" />
    <assembly fullname="Avalonia.Fonts.Inter" preserve="all" />
</linker>
