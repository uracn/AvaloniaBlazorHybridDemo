<?xml version="1.0" encoding="utf-8" ?>
<!-- NativeAOT root descriptor.
     Blazor activates Razor components, resolves routes and serializes IPC batches
     through reflection, so those assemblies must be kept intact. This is used only
     when EnableWindowsAot=true (publish-aot.ps1). Regular builds are unaffected. -->
<linker>
    <assembly fullname="AvaloniaBlazorHybridDemo" preserve="all" />

    <!-- Blazor rendering, routing, JS interop and WebView IPC -->
    <assembly fullname="Microsoft.AspNetCore.Components" preserve="all" />
    <assembly fullname="Microsoft.AspNetCore.Components.Forms" preserve="all" />
    <assembly fullname="Microsoft.AspNetCore.Components.Web" preserve="all" />
    <assembly fullname="Microsoft.AspNetCore.Components.WebView" preserve="all" />
    <assembly fullname="Microsoft.JSInterop" preserve="all" />
    <assembly fullname="System.Text.Json" preserve="all" />

    <!-- DI / logging / static content -->
    <assembly fullname="Microsoft.Extensions.DependencyInjection" preserve="all" />
    <assembly fullname="Microsoft.Extensions.DependencyInjection.Abstractions" preserve="all" />
    <assembly fullname="Microsoft.Extensions.Logging" preserve="all" />
    <assembly fullname="Microsoft.Extensions.Logging.Abstractions" preserve="all" />
    <assembly fullname="Microsoft.Extensions.FileProviders.Abstractions" preserve="all" />
    <assembly fullname="Microsoft.Extensions.FileProviders.Physical" preserve="all" />
    <assembly fullname="Microsoft.Extensions.FileProviders.Composite" preserve="all" />
    <assembly fullname="Microsoft.Extensions.Primitives" preserve="all" />

    <!-- Avalonia 12 official WebView (GeneratedComInterface based) -->
    <assembly fullname="Avalonia.Controls.WebView" preserve="all" />

    <!-- Avalonia XAML / control reflection -->
    <assembly fullname="Avalonia.Base" preserve="all" />
    <assembly fullname="Avalonia.Controls" preserve="all" />
    <assembly fullname="Avalonia.Markup" preserve="all" />
    <assembly fullname="Avalonia.Markup.Xaml" preserve="all" />
    <assembly fullname="Avalonia.Themes.Fluent" preserve="all" />
    <assembly fullname="Avalonia.Fonts.Inter" preserve="all" />
</linker>
