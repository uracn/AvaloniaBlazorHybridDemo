<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>AvaloniaBlazorHybridDemo</RootNamespace>
    <!-- Blazor CSS isolation / scoped CSS is handled by Blazor, not Avalonia -->
    <EnableDefaultCssItems>false</EnableDefaultCssItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avalonia 12.1.5：已实测与 BlazorWebView.Avalonia.Cross / WebView.Avalonia.Desktop.Cross
         11.3.1 兼容（编译 0 警告，首页渲染、路由、计数器交互均正常）。 -->
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.5" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>

    <!-- Avalonia-hosted Blazor Hybrid: Razor components run in-process, rendered by a native WebView -->
    <PackageReference Include="BlazorWebView.Avalonia.Cross" Version="11.3.1" />
    <PackageReference Include="WebView.Avalonia.Desktop.Cross" Version="11.3.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- ===== 实验性 Windows NativeAOT（已实测：不可用）=====
       参照 MauiBlazorAotDemo：TrimmerRootDescriptor 保留反射入口 +
       JsonSerializerIsReflectionEnabledByDefault 重新开启反射式 System.Text.Json。
       实测结果：ILC 确实吃进 Roots.xml（descriptor 参数），exe 由 23MB 增至 52MB，
       DryIoc 构造函数被裁导致的启动崩溃被修好、Avalonia 窗口能出现；
       但 WebView2 浏览器进程完全没创建（Assembly.Location / CodeBase 在 AOT 下失效），
       内容区全黑，Blazor 根本没有机会启动。后面还有 IpcCommon 反射式 JSON 序列化一关。
       保留此开关仅供复现实验；默认 CoreCLR + ReadyToRun 发布不受影响。 -->
  <PropertyGroup Condition="'$(EnableWindowsAot)' == 'true'">
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
  <ItemGroup Condition="'$(EnableWindowsAot)' == 'true'">
    <TrimmerRootDescriptor Include="Roots.xml" />
  </ItemGroup>
</Project>
