<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>AvaloniaBlazorHybridDemo</RootNamespace>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>
    <!-- One hand-written COM vtable call is used for WebView2's virtual host mapping. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.5" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>

    <!-- Avalonia 12's official WebView is AOT-compatible: its Windows backend uses
         GeneratedComInterface / StrategyBasedComWrappers instead of the legacy
         [ComImport] based Microsoft.Web.WebView2.Core, which cannot work under
         NativeAOT (IL3052 / ComWrappers exception). -->
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.1" />

    <!-- Official Blazor Hybrid rendering pipeline (WebViewManager + IPC). -->
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Physical" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- blazor.webview.js fetches "_framework/blazor.modules.json" before it sends
       AttachPage. WebView2's virtual-host mapping serves files straight from disk,
       so the file must exist physically. It is kept OUTSIDE wwwroot because the
       Microsoft.AspNetCore.Components.WebView package already registers the same
       path as a static web asset (a duplicate would break the SDK manifest). -->
  <ItemGroup>
    <None Include="Assets\blazor.modules.json"
          Link="wwwroot\_framework\blazor.modules.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Windows NativeAOT: .\publish-aot.ps1 produces a single native executable.
       Roots.xml keeps reflection entry points used by Blazor component activation,
       routing, JS interop and IPC JSON serialization.
       JsonSerializerIsReflectionEnabledByDefault re-enables the reflection-based
       System.Text.Json path in Components.WebView.IpcCommon. -->
  <PropertyGroup Condition="'$(EnableWindowsAot)' == 'true'">
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
  <ItemGroup Condition="'$(EnableWindowsAot)' == 'true'">
    <TrimmerRootDescriptor Include="Roots.xml" />
  </ItemGroup>
</Project>
